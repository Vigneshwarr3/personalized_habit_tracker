<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Special access the user grants in Settings > Usage access. Lets us read which app was in the foreground. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Location: one low-power fix every ~15 min, rounded to ~100 m on the phone. "Allow all the time" is
         needed because the fix is taken in the background. Activity recognition: vehicle / walking / still. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION" />
    <!-- In-app updates from your own server: Android still asks you to confirm every install. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ hides other apps' names unless the app declares it needs them: used only to show
         "Instagram" instead of com.instagram.android in your dashboard. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="Habit Tracker"
        android:theme="@android:style/Theme.DeviceDefault.DayNight"
        android:usesCleartextTraffic="false">

        <!-- Opens the dashboard (web app over Tailscale); settings live in a separate screen. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="Habit Tracker settings" />
        <receiver
            android:name=".InstallReceiver"
            android:exported="false" />
        <receiver
            android:name=".ActivityReceiver"
            android:exported="false" />
    </application>
</manifest>
